#!/bin/sh
# Move a unit to the cloud and start its claude --cloud session: sdlc-cloud <n> [--force] [--yes]
set -eu
[ $# -ge 1 ] || { echo "usage: sdlc-cloud <issue-number> [--force] [--yes]" >&2; exit 2; }
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$(git rev-parse --show-toplevel)"
# The SessionStart hook's token export, for a plain shell.
token=$(python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
from _common import load_json, repo_config
from session_start import _token_env, _token_path, _token_value
path = repo_config(".")
cfg = load_json(path) if path else {}
print(_token_value(_token_env(cfg), path and _token_path(cfg, path)) or "")
' "$root/hooks" 2>/dev/null) || token=
[ -z "$token" ] || export GITHUB_TOKEN="$token" GH_TOKEN="$token"
exec python3 "$root/scripts/sdlc_next.py" go-cloud "$@" --repo-path .

#!/bin/sh
# Start /sdlc:run on the orchestrator model (pipeline.orchestrator.model, else the policy's): sdlc-run <n> [extra claude args...]
set -eu
[ $# -ge 1 ] || { echo "usage: sdlc-run <initiative-or-epic-number> [claude args...]" >&2; exit 2; }
n=$1
shift
hooks="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/hooks"
model=$(python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
from _common import load_json, orchestrator_model, repo_config
path = repo_config(".")
print(orchestrator_model(load_json(path) if path else {}))
' "$hooks" 2>/dev/null) || model=sonnet
exec claude --model "$model" "/sdlc:run $n" "$@"

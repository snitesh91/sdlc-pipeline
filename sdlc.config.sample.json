{
  "_comment": "Template config for the sdlc-pipeline skill. Copy this into the repo you want to drive as `sdlc-pipeline.config.json` (or `.claude/sdlc-pipeline.config.json`) and replace every value below. The skill itself is generic and ships no real config. The projectFields ids are GitHub Projects-v2 schema ids for YOUR repo \u2014 look them up once via `gh api graphql` introspection. See README.md.",
  "repo": "owner/repo",
  "docRoot": "docs/sdlc",
  "tokenPath": "~/.github-token",
  "humanAssignee": "maintainer",
  "parallelism": {
    "devLane": 3,
    "prReview": 3,
    "designLane": 2
  },
  "requiredWorkflows": [
    {
      "workflow": "Backend CI",
      "suite": "backend",
      "prefixes": [
        "backend/"
      ],
      "files": [
        ".github/workflows/backend-ci.yml"
      ]
    },
    {
      "workflow": "Frontend CI",
      "suite": "frontend",
      "prefixes": [
        "frontend/"
      ],
      "files": [
        ".github/workflows/frontend-ci.yml"
      ]
    }
  ],
  "projectFields": {
    "issueTypeIds": {
      "Task": "IT_TASK_ID",
      "Bug": "IT_BUG_ID",
      "Feature": "IT_FEATURE_ID"
    },
    "priorityFieldId": "PRIORITY_FIELD_ID",
    "priorityOptionIds": {
      "Urgent": "PRIORITY_URGENT_ID",
      "High": "PRIORITY_HIGH_ID",
      "Medium": "PRIORITY_MEDIUM_ID",
      "Low": "PRIORITY_LOW_ID"
    },
    "effortFieldId": "EFFORT_FIELD_ID",
    "effortOptionIds": {
      "High": "EFFORT_HIGH_ID",
      "Medium": "EFFORT_MEDIUM_ID",
      "Low": "EFFORT_LOW_ID"
    },
    "stageFieldId": "STAGE_FIELD_ID",
    "stageOptionIds": {
      "product": "STAGE_PRODUCT_ID",
      "architecture": "STAGE_ARCHITECTURE_ID",
      "development": "STAGE_DEVELOPMENT_ID",
      "testing": "STAGE_TESTING_ID",
      "pr-review": "STAGE_PR_REVIEW_ID",
      "lld": "STAGE_LLD_ID"
    },
    "pipelineStatusFieldId": "PIPELINE_STATUS_FIELD_ID",
    "pipelineStatusOptionIds": {
      "todo": "STATUS_TODO_ID",
      "in-progress": "STATUS_IN_PROGRESS_ID",
      "awaiting-human-review": "STATUS_AWAITING_REVIEW_ID",
      "needs-human": "STATUS_NEEDS_HUMAN_ID",
      "feedback-received": "STATUS_FEEDBACK_RECEIVED_ID",
      "done": "STATUS_DONE_ID"
    },
    "projectId": "PROJECT_ID",
    "projectNumber": 1,
    "statusFieldId": "BOARD_STATUS_FIELD_ID",
    "statusOptionIds": {
      "todo": "BOARD_TODO_ID",
      "in-progress": "BOARD_IN_PROGRESS_ID",
      "done": "BOARD_DONE_ID"
    }
  },
  "pipeline": {
    "_comment": "Optional. Every key below is shown at its default; omit any you don't need to change. `python3 sdlc_next.py show-config` prints the effective values.",
    "labels": {
      "standing": "epic:standing",
      "legacy": "epic:legacy",
      "architected": "epic:architected"
    },
    "branches": {
      "issuePrefix": "issue-",
      "epicPrefix": "epic-",
      "gateSuffix": "-gate-"
    },
    "worktrees": {
      "root": "/tmp",
      "devPrefix": "sdlc-dev-",
      "epicPrefix": "sdlc-epic-",
      "reviewPrefix": "sdlc-review-"
    },
    "gates": {
      "_comment": "Global gate defaults; a profile's own `gates` override these for epics that match it.",
      "skipConfidenceThreshold": 95,
      "requiresHumanGateA": true
    },
    "escalation": {
      "replaceAt": 3,
      "needsHumanAt": 6
    },
    "retro": {
      "everyClosedIssues": 5,
      "watermarkFile": "{docRoot}/retro-watermark"
    },
    "continuous": {
      "cycleCap": 8
    },
    "models": {
      "product": "opus",
      "product-review": "opus",
      "architecture": "opus",
      "arch-review": "opus",
      "lld": "sonnet",
      "lld-review": "opus",
      "development": "sonnet",
      "testing": "sonnet",
      "pr-review": "opus"
    },
    "docTemplates": "_templates",
    "profiles": [
      {
        "_comment": "Ordered; the first whose `match` label is on the epic wins, `\"*\"` is the catch-all. A profile bundles the behaviour that used to be hardcoded to epic:standing/epic:legacy. Missing toggles inherit the shipped defaults; `gates` inherit the global `gates` above.",
        "name": "legacy",
        "match": { "label": "epic:legacy" },
        "driven": false
      },
      {
        "name": "standing",
        "match": { "label": "epic:standing" },
        "epicLevelPhase": false,
        "childEntryStage": "product",
        "childrenNeedArchitectedEpic": false,
        "closes": false,
        "gates": {
          "_comment": "A standing/RTB backlog: lower the Gate B skip bar and let children through Gate A without a human.",
          "skipConfidenceThreshold": 90,
          "requiresHumanGateA": false
        }
      },
      {
        "name": "default",
        "match": "*",
        "epicLevelPhase": true,
        "childEntryStage": "lld",
        "childrenNeedArchitectedEpic": true,
        "closes": true
      }
    ]
  }
}
